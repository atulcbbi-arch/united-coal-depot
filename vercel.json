{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/report?time=morning",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/report?time=evening",
      "schedule": "30 15 * * *"
    }
  ]
}